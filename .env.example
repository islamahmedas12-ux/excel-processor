# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-api-key
SUPABASE_BUCKET=excel-files

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES - MUST BE SET BEFORE RUNNING
# The application will fail fast if these are missing.
# =============================================================================

# Database Connection
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:port/database

# JWT Authentication Secret
# Must be a strong, random string (minimum 32 characters).
# NEVER commit the actual secret value to version control.
# Generate using: openssl rand -base64 64
JWT_SECRET_KEY=your-secure-jwt-secret-key-here

# Default Admin Password (FOR DEVELOPMENT ONLY - DO NOT USE IN PRODUCTION)
# This is the initial password for the default admin user account.
# CHANGE THIS IMMEDIATELY after first login and set ADMIN_PASSWORD_STRONG=true
# In production, use environment-specific secrets management
# (e.g., HashiCorp Vault, AWS Secrets Manager).
ADMIN_PASSWORD=your-secure-admin-password-here
ADMIN_PASSWORD_STRONG=false

# =============================================================================
# DOCKER COMPOSE LOCAL-DEV VARIABLES (only consumed by docker-compose.yml)
# =============================================================================
# Postgres (used by the docker-compose `postgres` service)
POSTGRES_USER=excel
POSTGRES_PASSWORD=
POSTGRES_DB=excel_processor

# MinIO (S3-compatible object storage; used by the docker-compose `minio` service)
MINIO_ROOT_USER=excel
MINIO_ROOT_PASSWORD=
